{
  "pack": {
    "pack_format": 1,
    "description": "§fDark§f Mode for §9GT§gNH §22.9.0§f\nnow §ka§r §cReimagined §f§ka§r§f! by Kuliiuu"
  },
  "gtnh_resource_pack_updater": {
    "schema": 1,
    "pack_name": "Dark GTNH Reimagined",
    "pack_version": "290.3",
    "pack_game_version": "2.9.X",
    "source": {
      "type": "github_releases",
      "owner": "Kuliiuu",
      "repo": "Dark-GTNH-Reimagined"
    }
  },
  "dark_mode_utils": {
    "schema": 1,
    "target": {
      "gui_font": {
        "input": {
          "minimum": "0x606666",
          "maximum": "0xBEBEBE"
        },
        "output": "0xFFFFFF",
        "shadow": true
      },
      "button_font": {
        "enabled":  { "output": "0xFFFFFF" },
        "hovered":  { "output": "0xFFFFA0" },
        "disabled": { "output": "0xA0A0A0" }
      },
      "shadows_global": true
    }
  }
}
